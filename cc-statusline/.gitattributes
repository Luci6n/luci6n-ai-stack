# Keep line endings stable across Windows and macOS.
# bash chokes on CRLF (e.g. a config value becomes "24h\r"), so shell code and
# config stay LF everywhere; Windows launchers stay CRLF.
*.sh       text eol=lf
*.command  text eol=lf
*.conf     text eol=lf
*.json     text eol=lf
*.ps1      text eol=crlf
*.cmd      text eol=crlf
