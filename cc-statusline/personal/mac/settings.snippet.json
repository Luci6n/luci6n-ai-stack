{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/coralline/statusline.sh",
    "refreshInterval": 1
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/coralline/statusline.sh --subagent"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/coralline/rotate-theme.sh"
          }
        ]
      }
    ]
  }
}
